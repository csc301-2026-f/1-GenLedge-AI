# Copy to src/backend/.env and replace every placeholder before starting Flask.
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:URL_ENCODED_PASSWORD@301db.dbestserv.com:5432/YOUR_DB_NAME
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
APP_ENV=development
DB_SSLMODE=require
# For verify-ca or verify-full, set this to the trusted server certificate path.
# DB_SSLROOTCERT=C:/path/to/server.crt
