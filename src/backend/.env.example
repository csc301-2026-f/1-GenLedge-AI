# Copy to src/backend/.env and replace every placeholder before starting Flask.
HOST=301db.dbestserv.com
PORT=5432
DATABASE=YOUR_DATABASE_NAME
USER=YOUR_DATABASE_USER
PASSWORD=YOUR_DATABASE_PASSWORD
APP_ENV=development
DB_SSLMODE=require

# Optional saved-inventory store; use your assigned PostgreSQL database and keep credentials private.
GENLEDGE_DATABASE_URL=
GENLEDGE_DATABASE_SCHEMA=genledge_control
